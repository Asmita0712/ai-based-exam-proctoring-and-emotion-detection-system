# Production Multi-Worker Backend Container for SentinelProctor AI
FROM python:3.11-slim

# Install system dependencies for OpenCV and MediaPipe
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python requirements
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY backend ./backend
COPY ml ./ml

# Pre-download/cache ML weights if available
RUN python -c "import torch; import os; os.makedirs(os.path.expanduser('~/.cache/torch/hub'), exist_ok=True)"

ENV PYTHONPATH="/app:/app/backend"
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Run multi-worker production ASGI server
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--limit-concurrency", "200"]
