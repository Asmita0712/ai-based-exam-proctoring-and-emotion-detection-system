# Copy to .env and adjust as needed. All values are read via
# backend/app/core/config.py with the PROCTOR_ prefix.

PROCTOR_ENVIRONMENT=development
PROCTOR_HOST=0.0.0.0
PROCTOR_PORT=8000
PROCTOR_FRONTEND_ORIGIN=http://localhost:5173

# Model paths (populated as real weights are added in later phases)
PROCTOR_FACE_MODEL_PATH=ml/models/face/yolov8n.pt
PROCTOR_EMOTION_MODEL_PATH=ml/models/emotion/
PROCTOR_FUSION_MODEL_PATH=ml/models/fusion/
PROCTOR_TEMPORAL_MODEL_PATH=ml/models/temporal/

# Thresholds
PROCTOR_GAZE_AWAY_THRESHOLD=0.35
PROCTOR_HEAD_TURN_YAW_THRESHOLD=30.0
PROCTOR_HEAD_TURN_PITCH_THRESHOLD=20.0
PROCTOR_SUSPICION_FLAG_THRESHOLD=0.5
